{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bsdc-info-bd/PASVL_LOSDA/schemas/registry-v1.schema.json",
  "title": "LOSDA Registry",
  "description": "The public LOSDA Registry. Append-only. Status is authoritative for third-party reliance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "framework_version", "updated_at", "records"],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$",
      "examples": ["2026.10.0"]
    },
    "framework_version": { "type": "string", "examples": ["1.0"] },
    "losda_spec_version": { "type": "string", "examples": ["1.0"] },
    "updated_at": { "type": "string", "format": "date-time" },
    "merkle_root": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 Merkle root over the sorted record hashes, published monthly."
    },
    "custodian": { "type": "string", "maxLength": 200 },
    "notes": { "type": "string", "maxLength": 4000 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "losda_id",
          "work_name",
          "repo_url",
          "class",
          "licensee_display",
          "country",
          "effective_date",
          "status",
          "record_hash"
        ],
        "properties": {
          "losda_id": {
            "type": "string",
            "pattern": "^LOSDA-[A-Z0-9]{3,8}-[0-9]{4}-[0-9]{6}$"
          },
          "work_name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "repo_url": { "type": "string", "format": "uri" },
          "class": {
            "type": "string",
            "enum": ["S", "E", "I", "H", "D", "A", "G", "P", "R", "X", "C", "M", "O"]
          },
          "licensee_display": {
            "type": "string",
            "maxLength": 200,
            "description": "Public display name, or an anonymised identifier such as 'L-2026-000123 (anonymised)'."
          },
          "anonymised": { "type": "boolean", "default": false },
          "country": { "type": "string", "maxLength": 100 },
          "territory": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "deployment_types": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "scale_band": {
            "type": "string",
            "enum": ["none", "1-100", "101-1000", "1001-10000", "10001-100000", "100000+", "unlimited", "n/a"],
            "default": "n/a"
          },
          "effective_date": { "type": "string", "format": "date" },
          "end_date": { "type": ["string", "null"], "format": "date" },
          "perpetual": { "type": "boolean", "default": false },
          "status": {
            "type": "string",
            "enum": ["pending", "active", "suspended", "expired", "revoked", "superseded", "withdrawn", "void"]
          },
          "status_updated_at": { "type": "string", "format": "date-time" },
          "revocation_reference": { "type": ["string", "null"], "maxLength": 100 },
          "record_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "previous_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "verification_url": { "type": "string", "format": "uri" },
          "confidential_annex": { "type": "boolean", "default": false }
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_records": { "type": "integer", "minimum": 0 },
        "active": { "type": "integer", "minimum": 0 },
        "suspended": { "type": "integer", "minimum": 0 },
        "revoked": { "type": "integer", "minimum": 0 },
        "expired": { "type": "integer", "minimum": 0 },
        "by_class": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
