{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bsdc-info-bd/PASVL_LOSDA/schemas/losda-v1.schema.json",
  "title": "LOSDA Record",
  "description": "Machine-readable record of a Letter of Software Deployment Approval issued under PASVL-1.0. Conforms to LOSDA-1.0. The record is authoritative for status; the signed letter is authoritative for narrative terms, and the two must agree.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "losda_id",
    "version",
    "license_version",
    "class",
    "work",
    "issuer",
    "licensee",
    "scope",
    "term",
    "effective_date",
    "status",
    "signature",
    "registry"
  ],
  "properties": {
    "losda_id": {
      "type": "string",
      "pattern": "^LOSDA-[A-Z0-9]{3,8}-[0-9]{4}-[0-9]{6}$",
      "description": "Permanent identifier. Format LOSDA-<ISSUER>-<YYYY>-<NNNNNN>. Never reused, even after revocation.",
      "examples": ["LOSDA-BSDC-2026-000001"]
    },
    "version": {
      "type": "string",
      "const": "LOSDA-1.0",
      "description": "Version of the LOSDA specification under which the instrument was issued."
    },
    "license_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "Version of PASVL under which the permission was granted.",
      "examples": ["1.0"]
    },
    "class": {
      "type": "string",
      "enum": ["S", "E", "I", "H", "D", "A", "G", "P", "R", "X", "C", "M", "O"],
      "description": "LOSDA class as defined in PASVL §10.14 and the LOSDA specification §6."
    },
    "class_label": {
      "type": "string",
      "description": "Human-readable class name.",
      "examples": ["Standard Commercial"]
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repo_url"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "repo_url": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "maxLength": 64 },
        "version_range": { "type": "string", "maxLength": 100 },
        "notice_url": { "type": "string", "format": "uri" }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "issuer_code", "capacity"],
      "properties": {
        "legal_name": { "type": "string", "minLength": 1 },
        "issuer_code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{3,8}$"
        },
        "capacity": {
          "type": "string",
          "enum": ["author", "co-author", "authorised_agent", "steward_continuity", "steward_extension"]
        },
        "country": { "type": "string", "maxLength": 100 },
        "signatory": { "type": "string", "maxLength": 200 },
        "contact": { "type": "string", "maxLength": 300 }
      }
    },
    "licensee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "entity_type"],
      "properties": {
        "legal_name": { "type": "string", "minLength": 1 },
        "display_name": {
          "type": "string",
          "description": "Public name for the registry, or an anonymised identifier."
        },
        "entity_type": {
          "type": "string",
          "enum": ["natural_person", "company", "non_profit", "government", "university", "consortium", "other"]
        },
        "registration_number": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "anonymised": { "type": "boolean", "default": false },
        "affiliates_covered": {
          "type": "array",
          "items": { "type": "string", "maxLength": 200 },
          "default": []
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment_types", "territory", "field_of_use"],
      "properties": {
        "deployment_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "internal",
              "customer_facing",
              "hosted_service",
              "embedded",
              "distributed_binary",
              "ml_training",
              "ml_evaluation",
              "research_testbed",
              "open_deployment"
            ]
          }
        },
        "territory": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "maxLength": 100 },
          "description": "Named territories, or ['Worldwide']."
        },
        "field_of_use": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "end_users": { "type": "integer", "minimum": 0 },
            "seats": { "type": "integer", "minimum": 0 },
            "instances": { "type": "integer", "minimum": 0 },
            "devices": { "type": "integer", "minimum": 0 },
            "monthly_api_requests": { "type": "integer", "minimum": 0 },
            "revenue_threshold_usd": { "type": "number", "minimum": 0 },
            "unlimited": { "type": "boolean", "default": false }
          }
        },
        "excluded_uses": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "sublicensing_permitted": { "type": "boolean", "default": false },
        "service_bureau_permitted": { "type": "boolean", "default": false },
        "modifications_permitted": { "type": "boolean", "default": true }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C([1-9]|1[0-6])$"
          },
          "uniqueItems": true,
          "default": []
        },
        "bespoke": {
          "type": "array",
          "items": { "type": "string", "maxLength": 2000 },
          "default": []
        },
        "ethics_policy_incorporated": { "type": "boolean", "default": false }
      }
    },
    "fees": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "payable": { "type": "boolean" },
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "basis": {
          "type": "string",
          "enum": ["none", "annual", "monthly", "one_off", "usage", "royalty", "negotiated"]
        },
        "confidential": { "type": "boolean", "default": false },
        "refund_policy": { "type": "string", "maxLength": 1000 }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": ["string", "null"], "format": "date" },
        "perpetual": { "type": "boolean", "default": false },
        "renewal": {
          "type": "string",
          "enum": ["none", "automatic", "by_application", "not_renewable"]
        },
        "reliance_period_days": { "type": "integer", "minimum": 0, "default": 180 }
      }
    },
    "effective_date": { "type": "string", "format": "date" },
    "status": {
      "type": "string",
      "enum": ["pending", "active", "suspended", "expired", "revoked", "superseded", "withdrawn", "void"]
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "to"],
        "properties": {
          "date": { "type": "string", "format": "date-time" },
          "from": { "type": ["string", "null"] },
          "to": { "type": "string" },
          "reason_code": { "type": "string", "maxLength": 100 },
          "reference": { "type": "string", "maxLength": 100 },
          "actor": { "type": "string", "maxLength": 200 }
        }
      },
      "default": []
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["handwritten", "qualified_e_signature", "platform", "pgp", "none"]
        },
        "signatory": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "format": "date" },
        "key_fingerprint": { "type": "string", "maxLength": 200 }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_hash", "recorded_at"],
      "properties": {
        "record_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the canonical JSON form of the record."
        },
        "previous_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "recorded_by": { "type": "string", "maxLength": 200 },
        "verification_url": { "type": "string", "format": "uri" }
      }
    },
    "confidential_annex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exists": { "type": "boolean", "default": false },
        "contents": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["fees", "security_requirements", "data_processing", "support", "other"]
          },
          "default": []
        }
      }
    },
    "notes": { "type": "string", "maxLength": 4000 }
  }
}
